# The root repo tracks only the shared workspace setup.
# Every project folder is ignored here because each one is its own git repo.
/*
!/.gitignore
!/CLAUDE.md
!/README.md
!/.claude/
!/_shared/
!/_templates/
!/_scripts/

# Personal / machine-local files
# PROJECTS.md is the private project list; it is ignored by /* above.
# Its format lives in _templates/PROJECTS.md, which is tracked.
CLAUDE.local.md
.claude/settings.local.json
